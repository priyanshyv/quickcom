{
  "name": "quickcom",
  "version": "0.0.1",
  "description": "Learning sandbox: a Blinkit-style 10-minute delivery backend for Bangalore, built one system-design idea at a time.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start:api": "ROLE=api nest start --watch",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/db/data-source.ts migration:run",
    "db:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/db/data-source.ts migration:revert",
    "db:seed": "ts-node -r tsconfig-paths/register db/seed/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:psql": "docker exec -it quickcom-postgres psql -U quickcom -d quickcom",
    "redis:cli": "docker exec -it quickcom-redis redis-cli",
    "load": "docker compose --profile load run --rm k6 run",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "start:prod": "node dist/main"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/geojson": "^7946.0.14",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
